<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Claude : la montre suit la réponse écran éteint (SuiviClaude) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Pas, étages, distance, calories en direct (Health Services) ; agenda pour la case du bas du cadran -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Claude : notification quand la réponse arrive ; dictée et lecture à voix haute de la montre -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Écran Cœur : le cœur en direct -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <!-- Débogage via Wi-Fi rallumé avec le Wi-Fi (droit donné une fois par adb, voir DebogageWifi.kt) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <queries>
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <!-- Case du bas : ouvrir l'appli d'un message, l'appli padel -->
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@drawable/ic_lanceur"
        android:label="@string/nom"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />

        <!-- Espace Pokémon : la barre, les balls du jour, le Pokédex (toucher la petite Poké Ball du cadran ; aussi dans
             la liste des applis de la montre) -->
        <activity
            android:name=".PokemonActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Espace Santé : l'activité du jour, le cœur et la nuit (toucher le cœur ou les pas du cadran) -->
        <activity
            android:name=".SanteActivity"
            android:exported="true"
            android:taskAffinity="" />

        <!-- Écran Cœur (toucher le cœur du cadran) -->
        <activity
            android:name=".CoeurActivity"
            android:exported="true"
            android:taskAffinity="" />

        <!-- Les tuiles (glisser à côté du cadran) -->
        <service
            android:name=".TuilePokemon"
            android:exported="true"
            android:label="Pokémon"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter><action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" /></intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/tuile_pokemon" />
        </service>
        <service
            android:name=".TuileSante"
            android:exported="true"
            android:label="Santé du jour"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter><action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" /></intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/tuile_sante" />
        </service>
        <service
            android:name=".TuileClaude"
            android:exported="true"
            android:label="Claude"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter><action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" /></intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/tuile_claude" />
        </service>

        <!-- Allume le micro de la dictée de Gboard pour l'écran Claude (Paramètres → Accessibilité) -->
        <service
            android:name=".AutoMicro"
            android:exported="false"
            android:label="@string/automicro"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/automicro" />
        </service>

        <!-- Demander à Claude (appui long sur le bouton, et dans la liste des applis) -->
        <activity
            android:name=".ClaudeActivity"
            android:exported="true"
            android:icon="@drawable/ic_claude_lanceur"
            android:label="Claude"
            android:launchMode="singleTask"
            android:taskAffinity="fr.kiki.pokemontre.claude">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pour que Claude remplace l'Assistant (appui long sur le bouton), voir CLAUDE.md -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Claude : suivi de la réponse écran éteint -->
        <service
            android:name=".SuiviClaude"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Plein écran : ouverture des Poké Balls -->
        <activity
            android:name=".OuvrirActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="" />

        <!-- Notifications de la montre pour la case libre du cadran (autorisation par Bugjaeger, voir Notifs.kt) -->
        <service
            android:name=".Notifs"
            android:exported="true"
            android:label="Pokémon (case du cadran)"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Les messages du téléphone, envoyés par l'appli « Pokémon » du téléphone (module telephone/) -->
        <service
            android:name=".DuTelephone"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/notif" />
            </intent-filter>
        </service>
        <activity
            android:name=".OuvrirSite"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name=".OuvrirNotif"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Chiffres en direct de la montre (Health Services, mode passif) -->
        <service
            android:name=".Passif"
            android:exported="true"
            android:permission="com.google.android.wearable.healthservices.permission.PASSIVE_DATA_BINDING" />

        <receiver
            android:name=".WifiArrive"
            android:exported="false" />

        <receiver
            android:name=".Demarrage"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Ligne du bas du cadran : Poké Balls à ouvrir, la nuit (au réveil) ou le prochain objectif -->
        <service
            android:name=".BasComplication"
            android:exported="true"
            android:icon="@drawable/ic_ball"
            android:label="@string/complication_bas"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="600" />
        </service>

        <!-- La barre d'effort et le nombre de Poké Balls, pour n'importe quel cadran -->
        <service
            android:name=".BarreComplication"
            android:exported="true"
            android:icon="@drawable/ic_ball"
            android:label="@string/complication"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="600" />
        </service>
    </application>
</manifest>
