# Copier ce fichier en « secret.properties » (jamais envoyé sur GitHub) et remplir :
# adresse de l'Application Web du script Google (la même que SCRIPT_URL dans les secrets Streamlit)
SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
# clé du jeu (fonction cleJeu() du script, la même que JEU_CLE dans les secrets Streamlit)
JEU_CLE=
