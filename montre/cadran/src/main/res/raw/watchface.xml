<?xml version="1.0" encoding="utf-8"?>
<!--
  Cadran « Pokémon Sport » (Watch Face Format 2, Wear OS 5+) : une montre classique, sobre et économe.
  - En haut la batterie (4 barres), puis la date et la météo, l'heure en grand.
  - Ligne santé : cardio et pas (montre, en direct ; toucher = espace Santé de l'appli), puis la petite Poké Ball au trait
    avec la barre d'effort « 48% » (complication BarreComplication) ; quand des balls sont gagnées, la Poké Ball 3D et
    « ×2 » à la place ; toucher = ouverture des balls, sinon l'espace Pokémon.
  - Claude s'ouvre par l'appui long sur le bouton (plus d'étoile sur le cadran depuis le 23/10).
  - En bas, la case libre (complication BasComplication, à changer dans Personnaliser) : la nuit au réveil, l'agenda,
    une info Pokémon… (plus tard : pronos NFL, padel).
  - Veille (écran toujours allumé) : l'heure en fin et la date. Toutes les zones à toucher sortent de l'écran (x = -1000)
    pour que le toucher qui réveille la montre n'ouvre rien (demande de Kiki). Fond noir partout.
-->
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
  <Metadata key="PREVIEW_TIME" value="15:58:00"/>
  <Scene backgroundColor="#ff000000">

    <!-- Batterie : 4 barres qui s'allument (rouges sous 20 %), toucher = état de la batterie -->
    <Group x="168" y="50" width="114" height="30" name="batterie">
      <Variant mode="AMBIENT" target="x" value="-1000"/>
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <Launch target="BATTERY_STATUS"/>
      <PartDraw x="10" y="7" width="38" height="18" name="pile">
        <RoundRectangle x="1" y="1" width="31" height="16" cornerRadiusX="4" cornerRadiusY="4">
          <Stroke thickness="2.5" color="#ff9a9a9a"/>
        </RoundRectangle>
        <Rectangle x="33" y="6" width="3" height="6"><Fill color="#ff9a9a9a"/></Rectangle>
      </PartDraw>
      <Condition>
        <Expressions>
          <Expression name="faible"><![CDATA[[BATTERY_PERCENT] <= 20]]></Expression>
        </Expressions>
        <Compare expression="faible">
          <PartDraw x="14" y="11" width="6" height="10" name="b1r"><Rectangle x="0" y="0" width="5" height="10"><Fill color="#ffff5a5f"/></Rectangle></PartDraw>
        </Compare>
        <Default>
          <PartDraw x="14" y="11" width="6" height="10" name="b1"><Rectangle x="0" y="0" width="5" height="10"><Fill color="#ff4cd3a0"/></Rectangle></PartDraw>
          <Condition>
            <Expressions>
              <Expression name="b2"><![CDATA[[BATTERY_PERCENT] >= 38]]></Expression>
            </Expressions>
            <Compare expression="b2">
              <PartDraw x="21" y="11" width="6" height="10" name="b2"><Rectangle x="0" y="0" width="5" height="10"><Fill color="#ff4cd3a0"/></Rectangle></PartDraw>
            </Compare>
          </Condition>
          <Condition>
            <Expressions>
              <Expression name="b3"><![CDATA[[BATTERY_PERCENT] >= 63]]></Expression>
            </Expressions>
            <Compare expression="b3">
              <PartDraw x="28" y="11" width="6" height="10" name="b3"><Rectangle x="0" y="0" width="5" height="10"><Fill color="#ff4cd3a0"/></Rectangle></PartDraw>
            </Compare>
          </Condition>
          <Condition>
            <Expressions>
              <Expression name="b4"><![CDATA[[BATTERY_PERCENT] >= 88]]></Expression>
            </Expressions>
            <Compare expression="b4">
              <PartDraw x="35" y="11" width="6" height="10" name="b4"><Rectangle x="0" y="0" width="5" height="10"><Fill color="#ff4cd3a0"/></Rectangle></PartDraw>
            </Compare>
          </Condition>
        </Default>
      </Condition>
      <PartText x="52" y="0" width="62" height="30" name="pourcent">
        <Text align="START">
          <Font family="SYNC_TO_DEVICE" size="21" color="#ff9a9a9a">
            <Template>%s%%<Parameter expression="[BATTERY_PERCENT]"/></Template>
          </Font>
        </Text>
      </PartText>
    </Group>

    <!-- Date et météo -->
    <Condition>
      <Expressions>
        <Expression name="meteo">[WEATHER.IS_AVAILABLE]</Expression>
      </Expressions>
      <Compare expression="meteo">
        <PartText x="40" y="92" width="370" height="36" name="date_meteo">
          <Variant mode="AMBIENT" target="alpha" value="150"/>
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="SYNC_TO_DEVICE" size="24" color="#ff9a9a9a">
              <Template><![CDATA[%s %s %s  ·  %s°]]>
                <Parameter expression="[DAY_OF_WEEK_S]"/>
                <Parameter expression="[DAY]"/>
                <Parameter expression="[MONTH_S]"/>
                <Parameter expression="[WEATHER.TEMPERATURE]"/>
              </Template>
            </Font>
          </Text>
        </PartText>
      </Compare>
      <Default>
        <PartText x="40" y="92" width="370" height="36" name="date">
          <Variant mode="AMBIENT" target="alpha" value="150"/>
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="SYNC_TO_DEVICE" size="24" color="#ff9a9a9a">
              <Template><![CDATA[%s %s %s]]>
                <Parameter expression="[DAY_OF_WEEK_S]"/>
                <Parameter expression="[DAY]"/>
                <Parameter expression="[MONTH_S]"/>
              </Template>
            </Font>
          </Text>
        </PartText>
      </Default>
    </Condition>

    <!-- L'heure : pleine en temps normal, fine et grise en veille -->
    <DigitalClock x="0" y="140" width="450" height="130">
      <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="450" height="130" alpha="255">
        <Variant mode="AMBIENT" target="alpha" value="0"/>
        <Font family="SYNC_TO_DEVICE" size="116" weight="MEDIUM" color="#ffffffff"/>
      </TimeText>
      <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="450" height="130" alpha="0">
        <Variant mode="AMBIENT" target="alpha" value="255"/>
        <Font family="SYNC_TO_DEVICE" size="116" weight="THIN" color="#ffbbbbbb"/>
      </TimeText>
    </DigitalClock>

    <!-- Cardio (toucher = écran Cœur) et pas (toucher = espace Santé) de l'appli Pokémon -->
    <Group x="70" y="270" width="96" height="44" name="coeur">
      <Variant mode="AMBIENT" target="x" value="-1000"/>
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <Launch target="fr.kiki.pokemontre/fr.kiki.pokemontre.CoeurActivity"/>
      <PartImage x="8" y="9" width="26" height="26" name="coeur">
        <Image resource="ic_coeur"/>
      </PartImage>
      <PartText x="38" y="2" width="58" height="40" name="cardio">
        <Text align="START">
          <Font family="SYNC_TO_DEVICE" size="25" color="#ffdddddd">
            <Template>%s<Parameter expression="[HEART_RATE] &gt; 0 ? [HEART_RATE] : &quot;--&quot;"/></Template>
          </Font>
        </Text>
      </PartText>
    </Group>
    <Group x="166" y="270" width="104" height="44" name="sante">
      <Variant mode="AMBIENT" target="x" value="-1000"/>
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <Launch target="fr.kiki.pokemontre/fr.kiki.pokemontre.SanteActivity"/>
      <PartImage x="0" y="9" width="26" height="26" name="pas">
        <Image resource="ic_pas"/>
      </PartImage>
      <PartText x="30" y="2" width="74" height="40" name="nb_pas">
        <Text align="START">
          <Font family="SYNC_TO_DEVICE" size="25" color="#ffdddddd">
            <Template>%s<Parameter expression="[STEP_COUNT]"/></Template>
          </Font>
        </Text>
      </PartText>
    </Group>

    <!-- La barre Pokémon : petite ball au trait + « 48% », ou la Poké Ball 3D + « ×2 » quand des balls sont gagnées -->
    <ComplicationSlot x="272" y="266" width="112" height="52" slotId="1" displayName="pokemon"
        supportedTypes="RANGED_VALUE EMPTY">
      <Variant mode="AMBIENT" target="x" value="-1000"/>
      <DefaultProviderPolicy
          primaryProvider="fr.kiki.pokemontre/fr.kiki.pokemontre.BarreComplication"
          primaryProviderType="RANGED_VALUE"
          defaultSystemProvider="WATCH_BATTERY"
          defaultSystemProviderType="RANGED_VALUE"/>
      <BoundingRoundBox x="0" y="0" width="112" height="52" cornerRadius="16"/>
      <Complication type="RANGED_VALUE">
        <Condition>
          <Expressions>
            <Expression name="balls"><![CDATA[[COMPLICATION.RANGED_VALUE_MAX] > 500]]></Expression>
          </Expressions>
          <Compare expression="balls">
            <PartImage x="0" y="2" width="48" height="48" alpha="255" name="ball3d">
              <Variant mode="AMBIENT" target="alpha" value="0"/>
              <Image resource="[COMPLICATION.SMALL_IMAGE]"/>
            </PartImage>
            <PartText x="50" y="6" width="62" height="40" alpha="255" name="nb_balls">
              <Variant mode="AMBIENT" target="alpha" value="0"/>
              <Text align="START">
                <Font family="SYNC_TO_DEVICE" size="27" weight="BOLD" color="#ffffcb05">
                  <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                </Font>
              </Text>
            </PartText>
            <PartImage x="12" y="14" width="24" height="24" alpha="0" tintColor="#ff888888" name="ball_veille">
              <Variant mode="AMBIENT" target="alpha" value="255"/>
              <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
            </PartImage>
          </Compare>
          <Default>
            <Group x="0" y="0" width="112" height="52" name="barre">
              <Variant mode="AMBIENT" target="alpha" value="0"/>
              <PartDraw x="4" y="13" width="26" height="26" name="ball_trait">
                <Ellipse x="2" y="2" width="22" height="22"><Stroke thickness="2.5" color="#ffdddddd"/></Ellipse>
                <Rectangle x="2" y="12" width="22" height="2.5"><Fill color="#ffdddddd"/></Rectangle>
                <Ellipse x="9" y="9" width="8" height="8"><Fill color="#ff000000"/></Ellipse>
                <Ellipse x="9" y="9" width="8" height="8"><Stroke thickness="2.5" color="#ffdddddd"/></Ellipse>
              </PartDraw>
              <PartText x="36" y="6" width="76" height="40" name="points">
                <Text align="START">
                  <Font family="SYNC_TO_DEVICE" size="25" color="#ffdddddd">
                    <Template>%s%%<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                  </Font>
                </Text>
              </PartText>
            </Group>
          </Default>
        </Condition>
      </Complication>
    </ComplicationSlot>

    <!-- La case libre du bas -->
    <ComplicationSlot x="55" y="330" width="340" height="76" slotId="2" displayName="bas"
        supportedTypes="LONG_TEXT EMPTY">
      <Variant mode="AMBIENT" target="x" value="-1000"/>
      <DefaultProviderPolicy
          primaryProvider="fr.kiki.pokemontre/fr.kiki.pokemontre.BasComplication"
          primaryProviderType="LONG_TEXT"
          defaultSystemProvider="NEXT_EVENT"
          defaultSystemProviderType="LONG_TEXT"/>
      <BoundingRoundBox x="0" y="0" width="340" height="76" cornerRadius="20"/>
      <Complication type="LONG_TEXT">
        <Group x="0" y="0" width="340" height="76" name="message">
          <Variant mode="AMBIENT" target="alpha" value="0"/>
          <PartText x="0" y="4" width="340" height="36" name="ligne1">
            <Text align="CENTER" ellipsis="TRUE">
              <Font family="SYNC_TO_DEVICE" size="23" color="#ffc9d3ea">
                <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
              </Font>
            </Text>
          </PartText>
          <PartText x="0" y="40" width="340" height="28" name="ligne2">
            <Text align="CENTER" ellipsis="TRUE">
              <Font family="SYNC_TO_DEVICE" size="18" color="#ff6f6f6f">
                <Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template>
              </Font>
            </Text>
          </PartText>
        </Group>
      </Complication>
    </ComplicationSlot>

  </Scene>
</WatchFace>
