<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Claude direct : le pont entre la montre et le relais de Termux (PontVocal.kt) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Test audio montre (TestAudio.kt) : brancher la montre comme micro et haut-parleur, le temps d'un essai -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Le faux appel de l'essai (personne n'est appelé) -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <queries>
        <package android:name="com.anthropic.claude" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_lanceur"
        android:label="Pokémon (montre)"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Un seul écran : dit si l'accès aux notifications est donné, et y mène -->
        <activity
            android:name=".Accueil"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Essai : la montre comme micro et haut-parleur du téléphone (icône à part « Test audio montre ») -->
        <activity
            android:name=".TestAudio"
            android:exported="true"
            android:label="Test audio montre"
            android:taskAffinity="fr.kiki.pokemontre.testaudio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".GardeAudio"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <service
            android:name=".AppelTest"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <!-- Claude direct : reçoit la phrase de la montre, la donne au relais de Termux, renvoie la réponse -->
        <service
            android:name=".PontVocal"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/vocal" />
            </intent-filter>
        </service>

        <!-- Lit les notifications du téléphone et envoie les messages à la montre -->
        <service
            android:name=".Relais"
            android:exported="true"
            android:label="Messages vers la montre (case du cadran)"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
